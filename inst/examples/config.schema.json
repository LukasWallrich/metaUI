{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metaUI app configuration versions 1 and 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data",
    "mapping",
    "dataset_name",
    "output"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "data": {
      "type": "string",
      "minLength": 1
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "primary_model": {
      "type": "string",
      "minLength": 1,
      "description": "Optional name of the default or author model shown first as the authors' primary analysis; never substituted when unsupported."
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_label",
        "es_field",
        "es_type"
      ],
      "properties": {
        "study_label": {
          "type": "string"
        },
        "es_field": {
          "type": "string"
        },
        "variance": {
          "type": "string"
        },
        "se": {
          "type": "string"
        },
        "es_id": {
          "type": "string"
        },
        "es_label": {
          "type": "string"
        },
        "pvalue": {
          "type": "string"
        },
        "sample_size": {
          "type": "string"
        },
        "article_label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "es_type": {
          "enum": [
            "SMD",
            "COR",
            "ZCOR"
          ]
        },
        "variance_scale": {
          "enum": [
            "SMD",
            "r",
            "z"
          ]
        },
        "direction": {
          "enum": [
            "unspecified",
            "positive",
            "negative"
          ]
        },
        "filters": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "na.rm": {
          "enum": [
            true,
            false,
            "es_related"
          ]
        },
        "arrange_filters": {
          "enum": [
            "given",
            "alphabetical",
            "leave"
          ]
        },
        "keep_missing_level": {
          "type": "boolean"
        },
        "categorical_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alternatives": {
          "type": "object",
          "maxProperties": 5,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "es_field",
              "es_type",
              "justification"
            ],
            "properties": {
              "es_field": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "variance": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "se": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "es_type": {
                "enum": [
                  "SMD",
                  "COR",
                  "ZCOR"
                ]
              },
              "variance_scale": {
                "enum": [
                  "SMD",
                  "r",
                  "z"
                ]
              },
              "justification": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "anyOf": [
              {
                "required": [
                  "variance"
                ]
              },
              {
                "required": [
                  "se"
                ]
              }
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "es_type": {
                      "const": "COR"
                    }
                  }
                },
                "then": {
                  "required": [
                    "variance_scale"
                  ],
                  "properties": {
                    "variance_scale": {
                      "const": "r"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "es_type": {
                      "const": "ZCOR"
                    }
                  }
                },
                "then": {
                  "required": [
                    "variance_scale"
                  ],
                  "properties": {
                    "variance_scale": {
                      "const": "z"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "es_type": {
                      "const": "SMD"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "variance_scale": {
                      "const": "SMD"
                    }
                  }
                }
              }
            ]
          },
          "propertyNames": {
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "const": "As supplied"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "variance"
          ]
        },
        {
          "required": [
            "se"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "es_type": {
                "const": "COR"
              }
            }
          },
          "then": {
            "required": [
              "variance_scale"
            ],
            "properties": {
              "variance_scale": {
                "const": "r"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "es_type": {
                "const": "ZCOR"
              }
            }
          },
          "then": {
            "required": [
              "variance_scale"
            ],
            "properties": {
              "variance_scale": {
                "const": "z"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "es_type": {
                "const": "SMD"
              }
            }
          },
          "then": {
            "properties": {
              "variance_scale": {
                "const": "SMD"
              }
            }
          }
        }
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlation_dependent": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "max_forest_plot_rows": {
          "type": "integer",
          "minimum": 1
        },
        "selection_list_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "shiny_theme": {
          "type": "string"
        },
        "fit_cache_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "osf_link": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "bayesian": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tau_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_studies": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "bayesian"
              ]
            },
            {
              "properties": {
                "mapping": {
                  "anyOf": [
                    {
                      "required": [
                        "alternatives"
                      ]
                    },
                    {
                      "required": [
                        "primary_label"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}
