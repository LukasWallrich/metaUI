{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metaUI app configuration versions 1 and 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data",
    "mapping",
    "dataset_name",
    "output"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "data": {
      "type": "string",
      "minLength": 1
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "static_folder": {
      "type": "string",
      "minLength": 1,
      "description": "Optional static site destination outside output; relative to the configuration file."
    },
    "primary_model": {
      "type": "string",
      "minLength": 1,
      "description": "Optional name of the default or author model shown first as the authors' primary analysis; never substituted when unsupported."
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_label",
        "es_type"
      ],
      "properties": {
        "study_label": {
          "type": "string"
        },
        "es_field": {
          "type": "string"
        },
        "variance": {
          "type": "string"
        },
        "se": {
          "type": "string"
        },
        "es_id": {
          "type": "string"
        },
        "es_label": {
          "type": "string"
        },
        "pvalue": {
          "type": "string"
        },
        "sample_size": {
          "type": "string"
        },
        "article_label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "es_type": {
          "enum": [
            "SMD",
            "COR",
            "ZCOR",
            "OR",
            "RR"
          ]
        },
        "variance_scale": {
          "enum": [
            "SMD",
            "r",
            "z",
            "log"
          ]
        },
        "direction": {
          "enum": [
            "unspecified",
            "positive",
            "negative"
          ]
        },
        "filters": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "na.rm": {
          "enum": [
            true,
            false,
            "es_related"
          ]
        },
        "arrange_filters": {
          "enum": [
            "given",
            "alphabetical",
            "leave"
          ]
        },
        "keep_missing_level": {
          "type": "boolean"
        },
        "categorical_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primary_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alternatives": {
          "type": "object",
          "maxProperties": 5,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "es_field",
              "es_type",
              "justification"
            ],
            "properties": {
              "es_field": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "variance": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "se": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "es_type": {
                "enum": [
                  "SMD",
                  "COR",
                  "ZCOR",
                  "OR",
                  "RR"
                ]
              },
              "variance_scale": {
                "enum": [
                  "SMD",
                  "r",
                  "z",
                  "log"
                ]
              },
              "justification": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "anyOf": [
              {
                "required": [
                  "variance"
                ]
              },
              {
                "required": [
                  "se"
                ]
              }
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "es_type": {
                      "const": "COR"
                    }
                  }
                },
                "then": {
                  "required": [
                    "variance_scale"
                  ],
                  "properties": {
                    "variance_scale": {
                      "const": "r"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "es_type": {
                      "const": "ZCOR"
                    }
                  }
                },
                "then": {
                  "required": [
                    "variance_scale"
                  ],
                  "properties": {
                    "variance_scale": {
                      "const": "z"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "es_type": {
                      "const": "SMD"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "variance_scale": {
                      "const": "SMD"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "es_type": {
                      "enum": [
                        "OR",
                        "RR"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "variance_scale"
                  ],
                  "properties": {
                    "variance_scale": {
                      "const": "log"
                    }
                  }
                }
              }
            ]
          },
          "propertyNames": {
            "minLength": 1,
            "pattern": "\\S",
            "not": {
              "const": "As supplied"
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "description": "For es_type OR or RR: 2x2 count columns, as in metafor::escalc. Events ai and ci with group totals n1i and n2i, or non-events bi and di. Leave es_field, variance, se and variance_scale out.",
          "properties": {
            "ai": {
              "type": "string",
              "minLength": 1
            },
            "bi": {
              "type": "string",
              "minLength": 1
            },
            "ci": {
              "type": "string",
              "minLength": 1
            },
            "di": {
              "type": "string",
              "minLength": 1
            },
            "n1i": {
              "type": "string",
              "minLength": 1
            },
            "n2i": {
              "type": "string",
              "minLength": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "ai",
                "ci",
                "n1i",
                "n2i"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "bi"
                    ]
                  },
                  {
                    "required": [
                      "di"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "ai",
                "bi",
                "ci",
                "di"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "n1i"
                    ]
                  },
                  {
                    "required": [
                      "n2i"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "double_zero": {
          "enum": [
            "keep",
            "exclude"
          ],
          "description": "With counts: keep (default, as metafor) or exclude tables with no events, or only events, in both groups."
        }
      },
      "anyOf": [
        {
          "required": [
            "es_field"
          ],
          "anyOf": [
            {
              "required": [
                "variance"
              ]
            },
            {
              "required": [
                "se"
              ]
            }
          ]
        },
        {
          "required": [
            "counts"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "es_type": {
                "const": "COR"
              }
            }
          },
          "then": {
            "required": [
              "variance_scale"
            ],
            "properties": {
              "variance_scale": {
                "const": "r"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "es_type": {
                "const": "ZCOR"
              }
            }
          },
          "then": {
            "required": [
              "variance_scale"
            ],
            "properties": {
              "variance_scale": {
                "const": "z"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "es_type": {
                "const": "SMD"
              }
            }
          },
          "then": {
            "properties": {
              "variance_scale": {
                "const": "SMD"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "counts"
            ]
          },
          "then": {
            "properties": {
              "es_type": {
                "enum": [
                  "OR",
                  "RR"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "es_field"
                  ]
                },
                {
                  "required": [
                    "variance"
                  ]
                },
                {
                  "required": [
                    "se"
                  ]
                },
                {
                  "required": [
                    "variance_scale"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "es_type"
            ],
            "properties": {
              "es_type": {
                "enum": [
                  "OR",
                  "RR"
                ]
              }
            },
            "not": {
              "required": [
                "counts"
              ]
            }
          },
          "then": {
            "required": [
              "variance_scale"
            ],
            "properties": {
              "variance_scale": {
                "const": "log"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "double_zero"
            ]
          },
          "then": {
            "required": [
              "counts"
            ]
          }
        }
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlation_dependent": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "max_forest_plot_rows": {
          "type": "integer",
          "minimum": 1
        },
        "selection_list_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "shiny_theme": {
          "type": "string"
        },
        "fit_cache_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "intro": {
          "type": "string",
          "description": "Optional HTML shown under the title: one or two sentences stating the question and what positive values mean."
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "osf_link": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "bayesian": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tau_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_studies": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional app_design() settings for interface styling and summary plot colours.",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
          "enum": [
            "source",
            "system",
            "arial",
            "verdana",
            "georgia"
          ]
        },
        "text_size": {
          "type": "number",
          "minimum": 14,
          "maximum": 20
        },
        "spacing": {
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "study_info": {
      "description": "Schema version 2. Either the path to a CSV of study details (one row per study; `study` column matching study IDs), or a lookup object that runs fetch_study_metadata() on the mapped `url` column while building and writes the result to `cache`. Shown in the effect-size list; the generated app never fetches metadata.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cache"
          ],
          "properties": {
            "cache": {
              "type": "string",
              "minLength": 1,
              "description": "CSV written by the lookup; found DOIs are reused on later builds. Relative to the configuration file."
            },
            "abstracts": {
              "enum": [
                "open_licence",
                "exclude_nc",
                "none",
                "all"
              ],
              "default": "open_licence"
            },
            "openalex": {
              "type": "boolean",
              "default": true,
              "description": "Use OpenAlex for licences and abstracts that Crossref lacks."
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "bayesian"
              ]
            },
            {
              "required": [
                "study_info"
              ]
            },
            {
              "properties": {
                "mapping": {
                  "anyOf": [
                    {
                      "required": [
                        "alternatives"
                      ]
                    },
                    {
                      "required": [
                        "primary_label"
                      ]
                    },
                    {
                      "required": [
                        "counts"
                      ]
                    },
                    {
                      "required": [
                        "double_zero"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}
